# drizzle-kit credentials template for the d1-http driver.
#
# Copy to `.env` (gitignored) and fill in real values ONLY if you want to use
# `drizzle-kit push` / `drizzle-kit migrate`. Day-to-day schema changes use:
#   npx drizzle-kit generate
#   npx wrangler d1 migrations apply sms-campaigns-db --local|--remote
# which do NOT need any of these.
#
# drizzle-kit auto-loads `.env` from this directory.

# Cloudflare account id (NOT a secret). Find with: npx wrangler whoami
CLOUDFLARE_ACCOUNT_ID=

# D1 database id (NOT a secret). Find with: npx wrangler d1 list
CLOUDFLARE_DATABASE_ID=

# Cloudflare API token with the "D1 Edit" permission (SECRET — never commit).
# Create at: My Profile -> API Tokens -> Create Token
CLOUDFLARE_D1_TOKEN=
