{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "pnpm@latest",
    "uv@latest",
    "sqlite@latest",
    "git@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Devbox ready: Node $(node -v), pnpm $(pnpm -v), uv $(uv --version)'",
      "test -f .env && set -a && source .env && set +a"
    ],
    "scripts": {
      "agent": "pnpm exec opencode",
      "dev": "pnpm run dev",
      "check": "pnpm run typecheck && pnpm run test",
      "deploy": "pnpm exec wrangler deploy"
    }
  }
}
