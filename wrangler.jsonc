{
	"name": "uk-sms-campaigns",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sms-campaigns-db",
			"database_id": "ae8b894d-e41d-4061-9678-e3ed4edef921",
			"migrations_dir": "src/db/migrations"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "SMS_QUEUE",
				"queue": "sms-campaign-jobs"
			}
		],
		"consumers": [
			{
				"queue": "sms-campaign-jobs",
				"max_batch_size": 5,
				"max_batch_timeout": 2,
				"max_concurrency": 2,
				"max_retries": 5,
				"dead_letter_queue": "sms-campaign-dlq"
			}
		]
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	}
}