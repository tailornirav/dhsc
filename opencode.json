{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepinfra/deepseek-ai/DeepSeek-V4-Pro-0813",
  "small_model": "deepinfra/deepseek-ai/DeepSeek-V4.1-Flash",
  "provider": {
    "deepinfra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepInfra",
      "options": {
        "baseURL": "https://api.deepinfra.com/v1/openai",
        "apiKey": "{env:DEEPINFRA_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro (Specs & Complex Coding)",
          "limit": { "context": 1000000, "output": 65536 }
        },
        "deepseek-ai/deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash (Fast Iteration)",
          "limit": { "context": 1000000, "output": 65536 }
        }
      }
    }
  }
}
